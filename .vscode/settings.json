{
  "json.schemas": [
    {
      "fileMatch": [
        "/taon.jsonc"
      ],
      "url": "./taon-config-standalone.schema.json"
    }
  ],
  "workbench.colorCustomizations": {
    "activityBar.background": "#36c455",
    "statusBar.background": "#2693ab",
    "statusBar.debuggingBackground": "#15d8ff"
  },
  "files.watcherExclude": {
    "local_release/**": true,
    "tmp-*/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/dist-nocutsrc/**": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "[json5]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "editor.rulers": [
    80,
    120
  ],
  "eslint.migration.2_x": "off",
  "eslint.enable": true,
  "prettier.enable": true,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.inlineSuggest.enabled": true,
  "prettier.prettierPath": "./node_modules/prettier",
  "prettier.endOfLine": "auto",
  "typescript.suggest.autoImports": false,
  "javascript.suggest.autoImports": false,
  "files.associations": {
    "tsconfig.json": "plaintext",
    "**/tsconfig.json": "plaintext",
    "**/tsconfig.*.json": "plaintext"
  },
  "search.followSymlinks": false,
  "search.useIgnoreFiles": false,
  "search.include": [
    "**/src/**"
  ],
  "search.exclude": {
    "bin": true,
    "local_release": true,
    "node_modules": true,
    ".build": true,
    ".vscode": true,
    "browser": true,
    "dist": true,
    "dist-*": true,
    "package-lock.json": true,
    "tmp-*": true,
    "src/lib/env/**/*.*": true,
    "*.rest": true,
    "**/bin": true,
    "**/local_release": true,
    "**/node_modules": true,
    "**/.build": true,
    "**/.vscode": true,
    "**/browser": true,
    "**/dist": true,
    "**/dist-*": true,
    "**/package-lock.json": true,
    "**/tmp-*": true,
    "**/src/lib/env/**/*.*": true,
    "**/*.rest": true,
    "projects": true,
    ".firedev": true,
    ".taon": true,
    ".tnp": true,
    "src/app.auto-gen-docs.md": true,
    "src/app.auto-gen-ver.js": true,
    ".ai": true,
    "databases": true,
    "**/.ai": true,
    "**/databases": true
  },
  "window.title": "taon-dev/e-commerce () [ ${activeEditorShort}]",
  "files.exclude": {
    "_changelog": false,
    ".sass-cache": false,
    ".sourcemaps": false,
    ".DS_Store": false,
    "**/.DS_Store": false,
    "npm-debug.log": false,
    "yarn-error.log": false,
    "testem.log": false,
    "connect.lock": false,
    "node_modules": false,
    "**/node_modules": false,
    "libpeerconnection.log": false,
    "dist": false,
    "coverage": false,
    "Thumbs.db": false,
    "browser": false,
    "**/browser": false,
    "websql": false,
    "**/websql": false,
    "eslint-rules": false,
    "dist-prod": false,
    "dist-nocutsrc": false,
    "dist-nocutsrc-prod": false,
    "package-lock.json": false,
    "*.i18n.data.ts": false,
    "**/*.i18n.data.ts": false,
    "chrome-profiler-events*.json": false,
    "speed-measure-plugin*.json": false,
    "tmp*": false,
    "npm-debug.log*": false,
    "tmp-*": false,
    "**/tmp-*": false,
    "dist*": false,
    "**/dist*": false,
    ".tnp": false,
    "**/.tnp": false,
    ".taon": false,
    "**/.taon": false,
    "tsconfig*": false,
    "**/tsconfig*": false,
    "*.schema.json": false,
    "**/*.schema.json": false,
    "eslint*": false,
    "**/eslint*": false,
    "run.js": false,
    "**/run.js": false,
    "webpack*": false,
    "**/webpack*": false,
    "index.js": false,
    "**/index.js": false,
    "index.js.map": false,
    "**/index.js.map": false,
    "index.d.ts": false,
    "**/index.d.ts": false,
    "vitest.config.ts": false,
    "**/vitest.config.ts": false,
    ".gitignore": false,
    "**/.gitignore": false,
    ".npmignore": false,
    "**/.npmignore": false,
    ".npmrc": false,
    "**/.npmrc": false,
    ".prettierrc": false,
    "**/.prettierrc": false,
    ".prettierignore": false,
    "**/.prettierignore": false,
    "update-vscode-package-json.js": false,
    "**/update-vscode-package-json.js": false,
    ".editorconfig": false,
    "**/.editorconfig": false,
    "package.json": false,
    "**/package.json": false,
    "*.filetemplate": false,
    "**/*.filetemplate": false,
    ".babelrc": false,
    "eslint.config.js": false,
    "protractor.conf.js": false,
    "karma.conf.js": false,
    ".prettierc": false,
    "angular.json": false,
    ".prettierrc.json": false,
    ".eslintrc.js": false,
    ".eslintrc.json": false,
    ".yarnrc": false,
    ".idea": false,
    "webpack.*": false,
    ".eslintrc*": false,
    "tslint.*": false,
    "!templates-subprojects/**/package.json": false,
    "AGENTS.md": false,
    "**/AGENTS.md": false,
    ".ai": false,
    "**/.ai": false,
    ".github/copilot-instructions.md": false,
    "**/.github/copilot-instructions.md": false,
    ".ai/examples": false,
    "**/.ai/examples": false
  }
}
