#: src/lib/taon-e-commerce-customer/taon-e-commerce-customer.repository.ts:100
msgid "Unable to load the current user cart."
msgstr "Der Warenkorb des aktuellen Benutzers kann nicht geladen werden."

#: src/lib/taon-e-commerce-customer/taon-e-commerce-customer.repository.ts:133
msgid "Unable to refresh the current user cart."
msgstr "Der Warenkorb des aktuellen Benutzers kann nicht aktualisiert werden."

#: src/lib/taon-e-commerce-customer/taon-e-commerce-customer.repository.ts:202
msgid "Product and quantity must be positive whole numbers."
msgstr "Produkt-ID und Menge müssen positive ganze Zahlen sein."

#: src/lib/taon-e-commerce-customer/taon-e-commerce-customer.repository.ts:214
msgid "The selected product is not available."
msgstr "Das ausgewählte Produkt ist nicht verfügbar."

#: src/lib/taon-e-commerce-customer/taon-e-commerce-customer.repository.ts:226
msgid "The cart was not found."
msgstr "Der Warenkorb wurde nicht gefunden."

#: src/lib/taon-e-commerce-customer/taon-e-commerce-customer.repository.ts:273
msgid "Item and quantity must be positive whole numbers."
msgstr "Artikel und Menge müssen positive ganze Zahlen sein."

#: src/lib/taon-e-commerce-customer/taon-e-commerce-customer.repository.ts:290
#: src/lib/taon-e-commerce-customer/taon-e-commerce-customer.repository.ts:333
msgid "The cart item was not found."
msgstr "Der Warenkorbartikel wurde nicht gefunden."

#: src/lib/taon-e-commerce-customer/taon-e-commerce-customer.repository.ts:322
msgid "The cart item ID is invalid."
msgstr "Die Warenkorb-Artikel-ID ist ungültig."

#: src/lib/taon-e-commerce-customer/taon-e-commerce-customer.repository.ts:437
msgid "Your cart has no active products to check out."
msgstr "Ihr Warenkorb enthält keine aktiven Produkte, die bezahlt werden können."

#: src/lib/taon-e-commerce-customer/taon-e-commerce-customer.repository.ts:455
msgid "A product in your cart is no longer available."
msgstr "Ein Produkt in Ihrem Warenkorb ist nicht mehr verfügbar."

#: src/lib/taon-e-commerce-customer/taon-e-commerce-customer.repository.ts:486
msgid "All products in one checkout must use the same currency."
msgstr "Alle Produkte in einem Bezahlvorgang müssen dieselbe Währung verwenden."

#: src/lib/taon-e-commerce-customer/taon-e-commerce-customer.repository.ts:522
msgid "A recurring subscription must be checked out by itself."
msgstr "Ein wiederkehrendes Abonnement muss separat bezahlt werden."
